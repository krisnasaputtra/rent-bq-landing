---
const steps = [
  {
    number: "1",
    title: "Create Account",
    description: "Set up your store account on our platform quickly and easily.",
  },
  {
    number: "2",
    title: "Add Inventory",
    description: "Upload your list of cameras, gadgets, and rental gear with all the necessary details.",
  },
  {
    number: "3",
    title: "Reach New Customers",
    description: "Your store is now ready to be discovered, and your gear is ready to be rented by thousands of potential customers!",
  },
];
---

<section class="py-20 bg-rentbq-dark-blue relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 parallax" data-speed="0.2">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="max-w-3xl mx-auto text-center">
      <div class="mb-4">
        <span class="mb-3 font-semibold text-rentbq-light-blue text-sm border py-2 px-4 bg-rentbq-gray rounded-2xl">How it Works?</span>
      </div>
      <h2 class="text-white animate-on-scroll delay-0 text-3xl md:text-4xl font-semibold">Grow Your Rental Business in 3 Easy Steps</h2>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connecting line between steps (visible on desktop) -->
      <!-- <div class="hidden md:block absolute top-16 left-1/6 right-1/6 h-0.5 bg-white"></div> -->
      
      {steps.map((step, index) => (
        <div 
          class={`bg-[#0A3A4E] rounded-xl p-8 animate-on-scroll delay-${index + 2} group hover:shadow-xl transition-all duration-300 hover:-translate-y-2`}
        >
          <p class="text-[5rem] font-bold max-h-24 overflow-hidden bg-clip-text text-transparent bg-gradient-to-t from-rentbq-dark-blue to-white">
            {step.number}          
          </p>
          <h3 class="mt-6 text-xl text-white font-semibold transition-colors duration-300">{step.title}</h3>
          <p class="mt-3 text-white">{step.description}</p>
          
          <!-- Arrow indicator for next step (visible on mobile) -->
          {index < steps.length - 1 && (
            <div class="flex justify-center mt-4 md:hidden">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-rentbq-light-blue animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
