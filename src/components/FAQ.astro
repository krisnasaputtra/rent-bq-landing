---
const faqs = [
  {
    question: "How do I integrate my store?",
    answer: "--"
  },
  {
    question: "Are there any hidden fees?",
    answer: "--"
  },
  {
    question: "How secure is my customer data?",
    answer: "--"
  },
  {
    question: "Can I upgrade or downgrade my plan later?",
    answer: "--"
  },
  {
    question: "Is technical support available?",
    answer: "--"
  },
  {
    question: "How do I cancel my subscription?",
    answer: "--"
  }
];
---

<section class="py-20 bg-white relative overflow-hidden" id="faq">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto animate-on-scroll">
      <div class="mb-4">
        <span class="mb-3 font-semibold text-rentbq-light-blue text-sm border py-2 px-4 bg-rentbq-gray rounded-2xl">FAQ</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold">
        Frequently Asked Questions
      </h2>
      <p class="mt-4 text-xl text-gray-600">
        Common Questions from Business Owners.
      </p>
    </div>
    
    <div class="mt-12 lg:max-w-5xl max-w-3xl mx-auto">
      {faqs.map((faq, index) => (
        <div 
          class="mb-6 bg-white overflow-hidden animate-on-scroll faq-item"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-6 transition-all duration-500 hover:bg-rentbq-gray border border-gray-200 shadow-sm rounded-lg ">
              <h3 class="text-lg font-medium transition-colors duration-500 group-hover:text-rentbq-light-blue">{faq.question}</h3>
              <div class="flex-shrink-0 ml-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-open:rotate-180 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <div class="overflow-hidden px-6 py-2 text-gray-600">
              <p>{faq.answer}</p>
            </div>
          </details>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center animate-on-scroll">
      <p class="text-gray-600">
        Still have questions? We're here to help.
      </p>
      <a href="#" class="mt-4 inline-flex items-center text-rentbq-light-blue font-medium hover:underline group">
        Contact Us 
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
