<section class="py-20 bg-rentbq-dark-blue text-white relative overflow-hidden">
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden opacity-10">
    <div class="absolute -top-40 -left-40 w-80 h-80 bg-white rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute top-40 -right-20 w-60 h-60 bg-white rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute -bottom-40 left-1/3 w-80 h-80 bg-white rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="max-w-4xl mx-auto text-center animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold">
        It's Time for Your Rental Business to Level Up!
      </h2>
      <p class="mt-6 text-lg opacity-70">
        Discover new customers daily and manage your inventory efficiently, all within one integrated solution.
      </p>
      <div class="mt-10">
        <a href="https://rent-camera-admin.vercel.app" target="_blank" class="btn bg-white text-rentbq-dark-blue hover:bg-opacity-90 transform transition-all duration-300 hover:scale-105 hover:shadow-lg">
          Get Started Now
        </a>
      </div>
    </div>
  </div>
</section>
