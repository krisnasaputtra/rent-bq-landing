---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import featureImage1 from '../assets/feature-1.svg';
import featureImage2 from '../assets/feature-2.svg';
import featureImage3 from '../assets/feature-3.svg';

const features = [
  {
    title: "Increased Visibility",
    description: "Get found by more customers. Promote all your gear to a wider, targeted audience.",
    icon: "ph:star-duotone",
    image: featureImage1,
  },
  {
    title: "Smart Inventory Management",
    description: "Track the real-time availability of every camera and gadget you own, preventing double-bookings.",
    icon: "ph:lightning-duotone",
    image: featureImage2,
  },
  {
    title: "Integrated Booking System",
    description: "Make it easy for customers to book directly through the platform, with automated confirmations.",
    icon: "ph:globe-duotone",
    image: featureImage3,
  },
  {
    title: "Analytics & Performance Reports",
    description: "Gain deep insights into your rental performance, best-selling products, and customer trends.",
    icon: "ph:globe-duotone",
    image: featureImage3,
  },
  {
    title: "Dedicated Support & Security",
    description: "Our responsive support team is ready to assist you. Your store data and transactions are secure with us.",
    icon: "ph:globe-duotone",
    image: featureImage3,
  },
];
---

<section class="lg:-mt-[200px] -mt-[80px] pb-20 relative overflow-hidden" id="features">
  <!-- Subtle background pattern with parallax effect -->
  <div class="absolute inset-0 opacity-5 parallax" data-speed="0.2">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom py-20 relative border bg-white rounded-2xl shadow-xl">
    <div class="text-left max-w-lg px-12">
      <div class="mb-4">
        <span class="mb-3 font-semibold text-rentbq-light-blue text-sm border py-2 px-4 bg-rentbq-gray rounded-2xl">Features</span>
      </div>
        <h2 class="animate-on-scroll left-to-right delay-0 text-3xl md:text-4xl font-semibold">
        <span class="font-bold bg-clip-text text-transparent bg-gradient-to-r from-rentbq-light-blue to-rentbq-dark-blue">Complete Solutions</span> for Your 
        Rental Business 
      </h2>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-24 px-12">
      {features.map((feature, index) => (
        <div class={`animate-on-scroll delay-${index + 2} group`}>
            <Icon name={feature.icon} class="h-8 w-8 mb-4 text-rentbq-light-blue" />
          <h3 class="text-xl font-semibold transition-colors duration-300 group-hover:text-rentbq-light-blue">{feature.title}</h3>
          <p class="mt-3 text-gray-600">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
